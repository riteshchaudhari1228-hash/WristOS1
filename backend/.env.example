# WristOS Backend — Environment Variables
# Set these in Render dashboard → Environment tab (do NOT commit real values)

# CORS: comma-separated list of allowed frontend origins
# ALLOWED_ORIGINS=https://wristos.vercel.app,https://wristos-preview.vercel.app

# Secret key for Android companion bridge token signing
# COMPANION_SECRET=your-secure-random-secret-here

# Optional: Postgres on Render (leave blank to use SQLite)
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# PORT is auto-set by Render — do not set manually
