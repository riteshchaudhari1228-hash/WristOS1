# WristOS Frontend — Environment Variables
# Copy this file to .env.local for local overrides (never commit .env.local)

# In LOCAL DEV: leave this blank — Vite proxy handles /api → localhost:8000
# VITE_API_URL=

# In VERCEL PRODUCTION: paste your Render backend URL here (no trailing slash)
# VITE_API_URL=https://wristos-backend.onrender.com
